<!--
  Minimal 2-joint planar arm for the dimOS twolink sim.

  Both hinges turn about Z, so the arm sweeps a horizontal plane (like a SCARA)
  and gravity puts no torque on the joints. Units are SI: meters, radians, kg.

  Actuator order is joint order: dimOS maps the coordinator's joint1, joint2
  to these <position> actuators by their order in the <actuator> block.
-->
<mujoco model="twolink">
  <compiler angle="radian"/>

  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <joint type="hinge" axis="0 0 1" range="-2.6 2.6" damping="0.5" armature="0.01"/>
    <!-- inheritrange="1" sets each actuator's ctrlrange to its joint's range. -->
    <position kp="50" kv="5" inheritrange="1" forcerange="-20 20"/>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="1 1 0.05" rgba="0.8 0.8 0.8 1" contype="1" conaffinity="1"/>

    <!-- Fixed base: a body with no joint is welded to the world. -->
    <body name="base_link" pos="0 0 0">
      <geom name="base" type="cylinder" size="0.05 0.05" pos="0 0 0.05" rgba="0.3 0.3 0.3 1"/>

      <body name="link1" pos="0 0 0.15">
        <joint name="joint1"/>
        <geom name="link1" type="capsule" fromto="0 0 0 0.15 0 0" size="0.02" rgba="0.8 0.3 0.2 1"/>

        <body name="link2" pos="0.15 0 0">
          <joint name="joint2"/>
          <geom name="link2" type="capsule" fromto="0 0 0 0.12 0 0" size="0.018" rgba="0.2 0.4 0.8 1"/>
          <site name="tip" pos="0.12 0 0" size="0.01"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="joint1" joint="joint1"/>
    <position name="joint2" joint="joint2"/>
  </actuator>
</mujoco>
